# Copia este archivo a `.env` y completa los valores. El `.env` NUNCA se versiona.
#   cp .env.example .env
#   openssl rand -hex 32        # genera el SESSION_SECRET

# Conexión de la APLICACIÓN. Idealmente el rol de menor privilegio
# `coworking_app` (lo crea `npm run db:roles`): DML sí, DDL no.
# Si prefieres el flujo simple, deja el usuario dueño aquí y define
# MIGRATOR_DATABASE_URL con el mismo valor.
DATABASE_URL=postgresql://localhost:5432/coworking
# Conexión con DDL para `npm run migrate` (crea tablas, índices, constraints).
# Si se omite, el migrador usa DATABASE_URL. Útil cuando la app va con el rol
# restringido y las migraciones necesitan el usuario dueño.
# MIGRATOR_DATABASE_URL=postgresql://tu_usuario@localhost:5432/coworking
PORT=3000
SESSION_SECRET=<generar con: openssl rand -hex 32>
TZ=America/Bogota

# IA (OpenCode Go — verificado en docs/03 §6.1). AI_API_KEY es OBLIGATORIA
# desde la Fase 5: el chat la usa y `loadConfig` lo exige al arrancar.
# Modelo recomendado glm-5.3-flash (de pago, barato); beam-free es gratis pero
# es de razonamiento y gasta el tope de tokens "pensando" en conversaciones largas.
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_API_KEY=oc_sk_...
AI_MODEL=glm-5.3-flash

# Control de uso del asistente (Fase 5b, docs/03 §6.3). Los límites por sesión
# son ventanas móviles sobre `chat_messages`; el presupuesto es global y mensual
# (entrada + salida). Vacío = sin presupuesto: solo se activa poniendo un número.
AI_MAX_TOKENS=4000
AI_MAX_PER_SESSION_MIN=5
AI_MAX_PER_SESSION_DAY=50
AI_MONTHLY_TOKEN_BUDGET=

# Recordatorios por correo (extensión posterior, docs/03 §9). El scheduler solo
# inserta en `email_outbox`; el worker existente envía y reintenta. Lead por
# defecto 48 h; catch-up 24 h para recuperar ticks perdidos.
REMINDER_ENABLED=true
REMINDER_LEAD_HOURS=48
REMINDER_SCAN_INTERVAL_MS=60000
REMINDER_CATCHUP_HOURS=24

# Límite de intentos de login (extensión posterior, docs/03 §10). Ventana móvil
# por correo y por IP; se guarda sha256, no el correo/IP en claro.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
