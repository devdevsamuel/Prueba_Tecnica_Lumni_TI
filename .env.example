# Copia este archivo a `.env` y completa los valores. El `.env` NUNCA se versiona.
#   cp .env.example .env
#   openssl rand -hex 32        # genera el SESSION_SECRET

DATABASE_URL=postgresql://localhost:5432/coworking
PORT=3000
SESSION_SECRET=<generar con: openssl rand -hex 32>
TZ=America/Bogota

# IA (OpenCode Go — verificado en docs/03 §6.1). AI_API_KEY solo es requerida desde la Fase 5.
AI_BASE_URL=https://opencode.ai/inference/go/openai/v1
AI_API_KEY=oc_sk_...
AI_MODEL=glm-5.3-flash
